+#!/usr/bin/env bash
+# bin/run.sh — orchestrator. Per Task 3 of implementation_plan.md, run.sh
+# must call validate_config() after load_config() and before using any
+# looked-up value, so an invalid config is caught before it is acted on.
+set -euo pipefail
+source "$(dirname "$0")/../lib/config.sh"
+
+load_config
+echo "host=$(get_value host)"
