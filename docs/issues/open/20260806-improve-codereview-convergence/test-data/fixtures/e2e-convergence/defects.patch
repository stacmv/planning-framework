+#!/usr/bin/env bash
+# lib/config.sh — configuration loading and validation helpers.
+#
+# Per Task 1 of implementation_plan.md: load_config() reads key=value pairs
+# from config/app.conf, with the path resolved relative to the repository
+# root. If the file is missing, load_config() must print an error to
+# stderr and exit with a non-zero status — callers rely on this to
+# distinguish "config missing" from "config present but empty".
+CONFIG_PATH="./app.conf"
+
+declare -A CONFIG_VALUES
+
+load_config() {
+  if [ ! -f "$CONFIG_PATH" ]; then
+    return 0
+  fi
+  while IFS='=' read -r key value; do
+    [ -z "$key" ] && continue
+    CONFIG_VALUES["$key"]="$value"
+  done < "$CONFIG_PATH"
+}
+
+# Per Task 2 of implementation_plan.md: get_value(key) looks up a key in
+# the loaded config map. On a missing key, it must return an empty string
+# AND print a warning to stderr — unknown keys are logged, never silently
+# ignored, so a typo in a key name is visible to whoever is reading the
+# script's output.
+get_value() {
+  local key="$1"
+  if [ -z "${CONFIG_VALUES[$key]+set}" ]; then
+    echo ""
+    return 0
+  fi
+  echo "${CONFIG_VALUES[$key]}"
+}
+
+# Per Task 4 of implementation_plan.md: validate_config() checks that every
+# key in REQUIRED_KEYS is present in CONFIG_VALUES. On a missing required
+# key, it must print which key is missing and exit non-zero.
+validate_config() {
+  return 0
+}
